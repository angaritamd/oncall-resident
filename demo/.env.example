# Copy to demo/.env (git-ignored) and set a strong password, e.g.:
#   printf 'ORTHANC_USER=oncall\nORTHANC_PASSWORD=%s\n' "$(openssl rand -hex 24)" > .env && chmod 600 .env
ORTHANC_USER=oncall
ORTHANC_PASSWORD=change-me
# Tailnet logins allowed to use the app (comma-separated, case-insensitive)
ALLOWED_USERS=you@example.com
# Logins that may see the exact model behind each tool call (optional)
ADMIN_USERS=
# Resident model (all optional; without them the resident runs in basic rule mode)
GLIMMER_BASE_URL=https://<workspace>--oncall-resident-glimmer-serve.<region>.modal.run/v1
GLIMMER_API_KEY=
MODEL_API_KEY=
# The Meta Model API backup only receives data when BOTH hold: DATA_CLASSIFICATION=synthetic here AND
# "synthetic": true in demo/seed/cases.json. Otherwise it stays disabled (Glimmer, then basic mode).
DATA_CLASSIFICATION=synthetic
# Reading station (OHIF): the app's public origin (frames the viewer) and the viewer's public URL
APP_ORIGIN=https://<host>.<tailnet>.ts.net
VIEWER_URL=https://<host>.<tailnet>.ts.net:8443
# Orthanc builds absolute WADO-RS URLs (BulkDataURI) with this host
VIEWER_HOST=<host>.<tailnet>.ts.net:8443
VIEWER_SSL=true
